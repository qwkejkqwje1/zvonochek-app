{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZVONochek",
  "mainBinaryName": "ZVONochek",
  "version": "4.0.0",
  "identifier": "com.zvonochek.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost https: wss:; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ZVONochek",
    "copyright": "© 2026 ZVONochek. Все права защищены.",
    "category": "SocialNetworking",
    "shortDescription": "ZVONochek — звонки по ссылке",
    "longDescription": "Голосовые и видеозвонки по ссылке без аккаунтов. Совместим с веб-версией ZVONochek.",
    "homepage": "https://github.com/qwkejkqwje1/zvonochek-app",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "ZVONochek"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["zvonochek"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCMkYwNzMyN0ZCN0EyOTQKUldTVW9yZC9NZ2N2bTVlekRFMEhkeGs4SzhYQkJENTNhN3FJc3VhMmN3aDh0c3M4bXpMLy9ReHYK",
      "endpoints": ["https://github.com/qwkejkqwje1/zvonochek-app/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
